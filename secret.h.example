#ifndef _SECRETS_
#define _SECRETS_

// GPX 轨迹自动上传服务配置
// 端点：POST https://tracks.example.com/api/ingest（占位示例，需自部署或自行填写）
// 认证：请求头 X-API-Key（大小写不敏感）

// 上传服务主机名（改成你自己的 tracks 服务域名）
#define TRACKS_API_HOST "tracks.example.com"
// 上传服务端口（HTTPS）
#define TRACKS_API_PORT 443
// 你的 API KEY：在 amap-gps-tracks 站点后台「API Keys」页面创建后粘贴到这里。
#define TRACKS_API_KEY  "PASTE_YOUR_API_KEY_HERE"

// ---- ntfy 推送通知（上传结果推送）----
// ntfy 服务器地址（默认官方 https://ntfy.sh，可改成自建实例）
#define NTFY_SH_SERVER      "https://ntfy.sh"
// 推送主题（topic），手机 ntfy App 里订阅同名主题即可收到
#define NTFY_SH_PUSH_TOPIC  "cyd_gpx_auto_upload_notify"

// ---- WebDAV 上传（可选，与 TRACKS 上传并存）----
// 目录基址（需在服务端预先存在），设备会把 GPX 文件 PUT 到 <该目录>/<文件名>.GPX
// 例如 "https://dav.example.com/moto/"（结尾斜杠可省略，固件会自动补齐）。
// 三项任一留空即视为「未配置」，跳过 WebDAV 上传。
#define WEBDAV_SERVER_URL "https://dav.example.com/moto/"
#define WEBDAV_USERNAME  "PASTE_YOUR_WEBDAV_USERNAME_HERE"
#define WEBDAV_PASSWORD  "PASTE_YOUR_WEBDAV_PASSWORD_HERE"

#endif // _SECRETS_
